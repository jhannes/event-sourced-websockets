{
  "scripts": {
    "dev": "concurrently npm:dev:backend npm:dev:frontend",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "tsc --noEmit && prettier --check .",
    "prepare": "husky",
    "postinstall": "npm run postinstall:backend && npm run postinstall:frontend",
    "postinstall:backend": "cd backend && npm install --include=dev",
    "postinstall:frontend": "cd frontend && npm install --include=dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhannes/contract-first-event-sourcing.git"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@types/express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.3"
  }
}
